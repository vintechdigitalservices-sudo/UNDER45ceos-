rules_version = '2';

// Firestore security rules for the Under 45 CEOs summit site.
//
// Ticket inventory is stored in ticket_inventory and read straight from
// the browser (the Admin-SDK API is not configured on this deployment).
// The rules below let anyone READ a count and let the checkout page make
// it go DOWN by exactly the shape of a real deduction — never up, never
// below zero, and only the count/timestamp fields. The per-order ledger
// document is the idempotency key that stops a double deduction.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ticket inventory ─────────────────────────────────────────
    match /ticket_inventory/{tier} {
      allow read: if true;             // public remaining counts

      // Create only with the official opening stock for that tier, so no
      // one can invent a tier or seed a fake count.
      allow create: if (
        (tier == 'essential'             && request.resource.data.initialQuantity == 49) ||
        (tier == 'growth'                && request.resource.data.initialQuantity == 25) ||
        (tier == 'executive'             && request.resource.data.initialQuantity == 18) ||
        (tier == 'founders_inner_circle' && request.resource.data.initialQuantity == 10)
      )
        && request.resource.data.remainingQuantity is int
        && request.resource.data.remainingQuantity >= 0
        && request.resource.data.remainingQuantity <= request.resource.data.initialQuantity;

      // Deduction only: the count may never increase or go negative, and
      // only the count/timestamp fields may change.
      allow update: if request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['remainingQuantity', 'updatedAt'])
                    && request.resource.data.remainingQuantity is int
                    && request.resource.data.remainingQuantity >= 0
                    && request.resource.data.remainingQuantity <= resource.data.remainingQuantity;

      allow delete: if false;
    }

    match /ticket_inventory_ledger/{orderId} {
      // Idempotency key, created once per order. Public read so the
      // checkout page can check it; immutable once written.
      allow read: if true;
      allow create: if request.resource.data.orderId == orderId
                    && request.resource.data.lines is list
                    && request.resource.data.lines.size() > 0;
      allow update, delete: if false;
    }

    match /ticket_inventory_claims/{claimId} {
      allow read, write: if false;     // checkout holds, server only
    }

    // ── Orders ───────────────────────────────────────────────────
    match /checkouts/{orderId} {
      // A buyer may create their own order (checkout writes it before
      // payment). Creation is allowed so the flow keeps working; note
      // that a buyer cannot self-declare a successful payment because
      // only the Admin SDK (server) may set paymentStatus to approved —
      // which now happens exclusively through
      // POST /api/tickets/review-order, gated on ADMIN_EMAILS.
      allow create: if request.resource.data.paymentStatus == 'pending'
                    && request.resource.data.status == 'awaiting_payment';

      // Buyers may attach their receipt while still pending, and may
      // read their own order. Nothing else.
      allow read: if true;             // order ref is an unguessable token

      // Two conditions, and both matter:
      //  • the NEW status must still be an unpaid one, and
      //  • the CURRENT status must also still be unpaid.
      // The second is what stops a buyer quietly reverting an already
      // approved order back to 'pending' after they have their ticket.
      allow update: if request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly([
                            'paymentStatus', 'status', 'receiptUrl',
                            'paymentDate', 'amountPaid', 'paymentSubmittedAt'
                          ])
                    && request.resource.data.paymentStatus in
                         ['pending', 'awaiting_verification']
                    && resource.data.paymentStatus in
                         ['pending', 'awaiting_verification'];
      allow delete: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ── Public form submissions ──────────────────────────────────
    match /contact_messages/{id} { allow create: if true; allow read, update, delete: if false; }
    match /sponsorship/{id}       { allow create: if true; allow read, update, delete: if false; }
    match /i_will_attend/{id}     { allow create: if true; allow read, update, delete: if false; }
    match /award_nominations/{id} { allow create: if true; allow read, update, delete: if false; }

    // ── Authenticated areas (volunteers) ─────────────────────────
    match /volunteers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /referrals/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Default deny.
    match /{document=**} { allow read, write: if false; }
  }
}